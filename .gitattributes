* text=auto eol=lf

# Keep common source and content files normalized to LF across Windows and WSL.
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.prisma text eol=lf
*.sh text eol=lf
*.svg text eol=lf
# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
# Upstream rendering code is intentionally vendored and excluded from
# GitHub language statistics.
vendor/bluemap-webapp/** linguist-vendored
# Page-specific media sources. Keep this after the general binary rules.
assets/media/** filter=lfs diff=lfs merge=lfs -text
